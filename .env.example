# Placeholders only. Never commit populated secrets or a real .env file.
# The CLI reads environment variables; it does not automatically load this file.
CORTANA_ENV=development
CORTANA_LOG_LEVEL=INFO
CORTANA_API_HOST=127.0.0.1
CORTANA_API_PORT=8000

# Install the optional provider with: python -m pip install -e ".[llm]"
# Set OPENAI_API_KEY or CORTANA_LLM_API_KEY in your shell; never commit the real value.
CORTANA_LLM_MODEL=gpt-6-luna
# Optional: custom endpoint must implement OpenAI Responses API.
# CORTANA_LLM_BASE_URL=https://api.openai.com/v1
# CORTANA_LLM_BASE_URL=http://127.0.0.1:1234/v1
