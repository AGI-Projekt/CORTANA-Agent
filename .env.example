# Placeholders only. Never commit populated secrets or a real .env file.
CORTANA_ENV=development
CORTANA_LOG_LEVEL=INFO
CORTANA_API_HOST=127.0.0.1
CORTANA_API_PORT=8000
# Use 1 to run the offline text demo. Keep unset for a real LLM response.
CORTANA_OFFLINE=1
# Install optional dependencies with: python -m pip install -e ".[llm,web]"
# Remove CORTANA_OFFLINE=1 and export OPENAI_API_KEY outside the repository.
CORTANA_LLM_MODEL=gpt-6-luna

# Optional full-duplex WebRTC voice session. The permanent key stays on the server.
CORTANA_REALTIME_MODEL=gpt-realtime-2.1
CORTANA_REALTIME_VOICE=marin
CORTANA_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional Emotion Core guidance for Realtime voice. Browser opt-in is also required.
CORTANA_REALTIME_EMOTION=0
